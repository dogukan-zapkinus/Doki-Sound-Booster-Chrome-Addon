{
  "manifest_version": 3,
  "name": "Doki Sound Booster",
  "version": "1.0.0",
  "description": "Free, open-source Chrome audio booster with up to 1000% gain and independent settings for each website.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Doki Sound Booster",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
